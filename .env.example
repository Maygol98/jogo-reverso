# porta do servidor
JOGO_PORT=8099

# senha do painel do apresentador — TROQUE
JOGO_KEY=troque-esta-chave

# IP que vai dentro do QR code.
# Deixe comentado para detectar automaticamente o IP da máquina (DHCP);
# defina só se precisar forçar (VPN, várias interfaces, nome local).
# JOGO_HOST=192.168.0.50

# binários, se não estiverem no PATH
# JOGO_YTDLP=/caminho/para/yt-dlp
# JOGO_NODE=/caminho/para/node

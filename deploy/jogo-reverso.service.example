[Unit]
Description=Jogo Reverso (musica ao contrario)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/jogo-reverso
Environment=JOGO_KEY=troque-esta-chave
Environment=JOGO_PORT=8099
# JOGO_HOST fica de fora de proposito: o IP e detectado sozinho (DHCP)
Environment=PATH=%h/jogo-reverso/.venv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/jogo-reverso/.venv/bin/python %h/jogo-reverso/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
